class TascaAnotacio<T> {
  - remuneracio: float
  - remuneracioPerDada: float
  - anotadoraAsignada: Anotadora
  - estatTasca: EstatsTasca
  - dadesFetes: List<T>
  - etiquetesPermeses: List<TipusEtiquetesCategoriques>
  - instrucions: String
  - expertesaRequerida: String
  - dataLimit: LocalDate
  - dadesPendents: List<T>
  - titol: String
  + toString(): String
  + getEstatTasca(): EstatsTasca
  + getEtiquetesPermeses(): List<TipusEtiquetesCategoriques>
  + setRemuneracio(float): void
  + ferDada(T): void
  + getTitol(): String
  + getAnotadoraAsignada(): Anotadora
  + isTascaDisponible(): boolean
  + getRemuneracioPerDada(): float
  + setAnotadoraAsignada(Anotadora): void
  + setEstatTasca(EstatsTasca): void
  + getRemuneracio(): float
  + getDadesPendents(): List<T>
  + setDadesFetes(List<T>): void
  + assignarAnotadora(Anotadora): void
  + setDadesPendents(List<T>): void
  + getExpertesaRequerida(): String
  + getDataLimit(): LocalDate
  + getDadesFetes(): List<T>
  + addDadesPendents(T): void
  + getInstrucions(): String
  + avaluarEstatTasca(): void
}
