  + canviarEstatTasca(EstatsTasca, String): void
  + afegirTascaAnotacioDocument(String, String, String, float, LocalDate, List<TipusEtiquetesCategoriques>): void
  + isUsuariAsignatATasca(String, String): boolean
  - trobarUsuari(String): Anotadora
