  - trobarAtributFaltant(String, String, String, String, String, String, LocalDate, String, String, String, String, List<String>): String
  + completarDadesTasca(String, int): void
  + registrarUsuari(String, String, String, String, String, String, LocalDate, String, String, String, String, List<String>): String
  + assignarTascaAAnotadora(String, String): String
  - trobarTasca(String): TascaAnotacio<?>
