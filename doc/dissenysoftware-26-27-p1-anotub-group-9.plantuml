  + getControlador(): Controlador
}

AnotacioDadaAmbEtiquetesStepDefs    "1" *-[#595959,plain]-> "state\n1" WorldState                          
AppContainer                        "1" *-[#595959,plain]-> "controlador\n1" Controlador                         
AssignarTascaStepDefs               "1" *-[#595959,plain]-> "state\n1" WorldState                          
CompletarTascaStepDefs              "1" *-[#595959,plain]-> "dadesDisponibles\n*" Imatge                              
CompletarTascaStepDefs              "1" *-[#595959,plain]-> "tascaActual\n1" TascaAnotacio                       
CompletarTascaStepDefs              "1" *-[#595959,plain]-> "state\n1" WorldState                          
ConsultaRemuneracioTascaStepDefs    "1" *-[#595959,plain]-> "state\n1" WorldState                          
Controlador                         "1" *-[#595959,plain]-> "usuaries\n*" Anotadora                           
Controlador                         "1" *-[#595959,plain]-> "tasques\n*" TascaAnotacio                       
Dada                                "1" *-[#595959,plain]-> "etiquetes\n*" EtiquetesCategoriques               
Dada                                "1" *-[#595959,plain]-> "tascaAsociada\n1" TascaAnotacio                       
Document                             -[#000082,plain]-^  Dada                                
IdentificacioUsuariStepDefs         "1" *-[#595959,plain]-> "state\n1" WorldState                          
Imatge                               -[#000082,plain]-^  Dada                                
RegistreUsuariStepDefs              "1" *-[#595959,plain]-> "state\n1" WorldState                          
SistemaStepDefs                     "1" *-[#595959,plain]-> "state\n1" WorldState                          
TascaAnotacio                       "1" *-[#595959,plain]-> "anotadoraAsignada\n1" Anotadora                           
TascaAnotacioDocument                -[#000082,plain]-^  TascaAnotacio                       
TascaAnotacioImatge                  -[#000082,plain]-^  TascaAnotacio                       
TasquesDisponiblesAnotadorsStepDefs "1" *-[#595959,plain]-> "state\n1" WorldState                          
WorldState                          "1" *-[#595959,plain]-> "controlador\n1" Controlador                         
